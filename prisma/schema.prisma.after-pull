generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Firm {
  id                   String                @id @default(cuid())
  name                 String
  registrationNumber   String?
  taxNumber            String?
  email                String?
  phone                String?
  address              String?
  city                 String?
  province             String?
  country              String                @default("South Africa")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  currency             String                @default("ZAR")
  vatNumber            String?
  accountantReviews    AccountantReview[]
  auditLogs            AuditLog[]
  bankAccounts         BankAccount[]
  bankTransactions     BankTransaction[]
  clients              Client[]
  creditNotes          CreditNote[]
  documents            Document[]
  expenses             Expense[]
  financialPeriods     FinancialPeriod[]
  users                FirmUser[]
  invoices             Invoice[]
  journalEntries       JournalEntry[]
  ledgerAccounts       LedgerAccount[]
  matters              Matter[]
  payments             Payment[]
  purchaseInvoices     PurchaseInvoice[]
  recurringInvoices    RecurringInvoice[]
  suppliers            Supplier[]
  supplierPayments     SupplierPayment[]
  taxRates             TaxRate[]
  taxReturns           TaxReturn[]
  trustAccounts        TrustAccount[]
  trustReconciliations TrustReconciliation[]
  trustTransactions    TrustTransaction[]
}

model FirmUser {
  id                       String             @id @default(cuid())
  firmId                   String
  name                     String
  email                    String
  passwordHash             String
  role                     Role               @default(STAFF)
  active                   Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  reviews                  AccountantReview[] @relation("ReviewBy")
  auditLogs                AuditLog[]
  uploadedDocuments        Document[]         @relation("DocumentUploadedBy")
  createdExpenses          Expense[]          @relation("ExpenseCreatedBy")
  closedPeriods            FinancialPeriod[]  @relation("ClosedBy")
  firm                     Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  createdInvoices          Invoice[]          @relation("InvoiceCreatedBy")
  journalEntries           JournalEntry[]     @relation("JournalCreatedBy")
  recordedPayments         Payment[]          @relation("PaymentRecordedBy")
  createdSupplierPayments  SupplierPayment[]
  createdTrustTransactions TrustTransaction[]

  @@unique([firmId, email])
  @@index([firmId])
}

model Client {
  id                 String             @id @default(cuid())
  firmId             String
  clientType         ClientType?
  name               String?
  surname            String?
  companyName        String?
  email              String?
  phone              String?
  idNumber           String?
  registrationNumber String?
  taxNumber          String?
  address            String?
  city               String?
  province           String?
  country            String             @default("South Africa")
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  clientCode         String?
  displayName        String?
  type               ClientType         @default(INDIVIDUAL)
  firm               Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  creditNotes        CreditNote[]
  documents          Document[]
  expenses           Expense[]
  invoices           Invoice[]
  matters            Matter[]
  payments           Payment[]
  recurringInvoices  RecurringInvoice[]
  trustTransactions  TrustTransaction[]

  @@unique([firmId, clientCode])
  @@index([firmId])
  @@index([firmId, displayName])
}

model Matter {
  id                String             @id @default(cuid())
  firmId            String
  clientId          String
  matterNumber      String
  title             String
  description       String?
  practiceArea      String?
  status            MatterStatus       @default(OPEN)
  openedAt          DateTime           @default(now())
  closedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  documents         Document[]
  expenses          Expense[]
  invoices          Invoice[]
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firm              Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  payments          Payment[]
  purchaseInvoices  PurchaseInvoice[]
  recurringInvoices RecurringInvoice[]
  trustTransactions TrustTransaction[]

  @@unique([firmId, matterNumber])
  @@index([firmId])
  @@index([clientId])
}

model Invoice {
  id            String        @id @default(cuid())
  firmId        String
  clientId      String
  matterId      String?
  createdById   String?
  invoiceNumber String
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Decimal       @db.Decimal(18, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(18, 2)
  total         Decimal       @db.Decimal(18, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(18, 2)
  balanceDue    Decimal       @db.Decimal(18, 2)
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  creditNotes   CreditNote[]
  documents     Document[]
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy     FirmUser?     @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  firm          Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter        Matter?       @relation(fields: [matterId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([firmId, invoiceNumber])
  @@index([firmId])
  @@index([clientId])
  @@index([matterId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1) @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(18, 2)
  lineTotal   Decimal @db.Decimal(18, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model CreditNote {
  id           String     @id @default(cuid())
  invoiceId    String?
  creditNumber String
  amount       Decimal    @default(0) @db.Decimal(18, 2)
  reason       String?
  issueDate    DateTime   @default(now())
  createdAt    DateTime   @default(now())
  clientId     String?
  firmId       String
  subtotal     Decimal    @default(0) @db.Decimal(18, 2)
  taxAmount    Decimal    @default(0) @db.Decimal(18, 2)
  total        Decimal    @default(0) @db.Decimal(18, 2)
  client       Client?    @relation(fields: [clientId], references: [id])
  firm         Firm       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invoice      Invoice?   @relation(fields: [invoiceId], references: [id])
  documents    Document[]

  @@unique([firmId, creditNumber])
  @@index([firmId])
  @@index([clientId])
  @@index([invoiceId])
}

model Payment {
  id               String            @id @default(cuid())
  firmId           String
  clientId         String?
  invoiceId        String?
  recordedById     String?
  paymentNumber    String            @default(cuid())
  amount           Decimal           @db.Decimal(18, 2)
  paymentDate      DateTime          @default(now())
  method           String?
  reference        String?
  status           PaymentStatus     @default(RECEIVED)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  matterId         String?
  bankTransactions BankTransaction[]
  documents        Document[]
  client           Client?           @relation(fields: [clientId], references: [id])
  firm             Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id])
  matter           Matter?           @relation(fields: [matterId], references: [id])
  recordedBy       FirmUser?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@unique([firmId, paymentNumber])
  @@index([firmId])
  @@index([clientId])
  @@index([matterId])
  @@index([invoiceId])
}

model RecurringInvoice {
  id          String   @id @default(cuid())
  firmId      String
  clientId    String
  matterId    String?
  description String
  amount      Decimal  @default(0) @db.Decimal(18, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  frequency   String
  nextRunDate DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subtotal    Decimal  @default(0) @db.Decimal(18, 2)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter      Matter?  @relation(fields: [matterId], references: [id])

  @@index([firmId])
  @@index([clientId])
  @@index([matterId])
  @@index([nextRunDate])
}

model Expense {
  id            String        @id @default(cuid())
  firmId        String
  clientId      String?
  matterId      String?
  supplierId    String?
  createdById   String?
  description   String
  amount        Decimal       @db.Decimal(18, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(18, 2)
  total         Decimal       @default(0) @db.Decimal(18, 2)
  expenseDate   DateTime      @default(now())
  status        ExpenseStatus @default(DRAFT)
  receiptUrl    String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  bankAccountId String?
  documents     Document[]
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id])
  client        Client?       @relation(fields: [clientId], references: [id])
  createdBy     FirmUser?     @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  firm          Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter        Matter?       @relation(fields: [matterId], references: [id])
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])

  @@index([firmId])
  @@index([clientId])
  @@index([matterId])
  @@index([supplierId])
  @@index([bankAccountId])
}

model BankAccount {
  id               String            @id @default(cuid())
  firmId           String
  name             String
  bankName         String?
  accountNumber    String?
  branchCode       String?
  accountType      String?
  currency         String            @default("ZAR")
  openingBalance   Decimal           @default(0) @db.Decimal(18, 2)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isTrust          Boolean           @default(false)
  firm             Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  transactions     BankTransaction[]
  expenses         Expense[]
  supplierPayments SupplierPayment[]

  @@index([firmId])
}

model BankTransaction {
  id              String              @id @default(cuid())
  firmId          String
  bankAccountId   String
  paymentId       String?
  transactionDate DateTime
  type            BankTransactionType
  amount          Decimal             @db.Decimal(18, 2)
  description     String?
  reference       String?
  matched         Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  bankAccount     BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  firm            Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)
  payment         Payment?            @relation(fields: [paymentId], references: [id])
  documents       Document[]

  @@index([firmId])
  @@index([bankAccountId])
  @@index([transactionDate])
  @@index([matched])
}

model LedgerAccount {
  id           String        @id @default(cuid())
  firmId       String
  code         String
  name         String
  type         String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  accountType  AccountType?
  journalLines JournalLine[]
  firm         Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, code])
  @@index([firmId])
}

model JournalEntry {
  id          String           @id @default(cuid())
  firmId      String
  periodId    String?
  createdById String?
  reference   String?
  description String?
  entryDate   DateTime         @default(now())
  createdAt   DateTime         @default(now())
  sourceId    String?
  sourceType  String?
  createdBy   FirmUser?        @relation("JournalCreatedBy", fields: [createdById], references: [id])
  firm        Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  period      FinancialPeriod? @relation(fields: [periodId], references: [id])
  lines       JournalLine[]

  @@index([firmId])
  @@index([periodId])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id              String        @id @default(cuid())
  journalEntryId  String
  ledgerAccountId String
  description     String?
  debit           Decimal       @default(0) @db.Decimal(18, 2)
  credit          Decimal       @default(0) @db.Decimal(18, 2)
  journalEntry    JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id])

  @@index([journalEntryId])
  @@index([ledgerAccountId])
}

model TaxRate {
  id        String   @id @default(cuid())
  firmId    String
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
}

model FinancialPeriod {
  id             String                @id @default(cuid())
  firmId         String
  name           String
  startDate      DateTime
  endDate        DateTime
  status         FinancialPeriodStatus @default(OPEN)
  closedBy       String?
  closedAt       DateTime?
  createdAt      DateTime              @default(now())
  reviews        AccountantReview[]
  documents      Document[]
  closer         FirmUser?             @relation("ClosedBy", fields: [closedBy], references: [id])
  firm           Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([firmId, startDate, endDate])
  @@index([firmId])
}

model AccountantReview {
  id         String           @id @default(cuid())
  firmId     String
  periodId   String?
  reviewerId String?
  status     ReviewStatus     @default(PENDING)
  comments   String?
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())
  notes      String?
  title      String
  firm       Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  period     FinancialPeriod? @relation(fields: [periodId], references: [id], onDelete: Cascade)
  reviewer   FirmUser?        @relation("ReviewBy", fields: [reviewerId], references: [id])

  @@index([firmId])
  @@index([periodId])
  @@index([status])
}

model AuditLog {
  id        String    @id @default(cuid())
  firmId    String
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime  @default(now())
  firm      Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user      FirmUser? @relation(fields: [userId], references: [id])

  @@index([firmId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Supplier {
  id                 String            @id @default(cuid())
  firmId             String
  supplierType       SupplierType      @default(COMPANY)
  name               String
  registrationNumber String?
  taxNumber          String?
  email              String?
  phone              String?
  address            String?
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  supplierCode       String?
  type               SupplierType      @default(COMPANY)
  vatNumber          String?
  expenses           Expense[]
  purchaseInvoices   PurchaseInvoice[]
  firm               Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  payments           SupplierPayment[]

  @@unique([firmId, supplierCode])
  @@index([firmId])
}

model PurchaseInvoice {
  id            String                @id @default(cuid())
  firmId        String
  supplierId    String
  invoiceNumber String
  invoiceDate   DateTime
  dueDate       DateTime?
  subtotal      Decimal               @db.Decimal(18, 2)
  taxAmount     Decimal               @default(0) @db.Decimal(18, 2)
  total         Decimal               @db.Decimal(18, 2)
  amountPaid    Decimal               @default(0) @db.Decimal(18, 2)
  balanceDue    Decimal               @db.Decimal(18, 2)
  status        PurchaseInvoiceStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  description   String?
  matterId      String?
  documents     Document[]
  firm          Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter        Matter?               @relation(fields: [matterId], references: [id])
  supplier      Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  payments      SupplierPayment[]

  @@unique([firmId, invoiceNumber])
  @@index([firmId])
  @@index([supplierId])
  @@index([matterId])
}

model SupplierPayment {
  id                String           @id @default(cuid())
  firmId            String
  supplierId        String
  purchaseInvoiceId String?
  bankAccountId     String?
  createdById       String?
  paymentNumber     String           @default(cuid())
  amount            Decimal          @db.Decimal(18, 2)
  paymentDate       DateTime         @default(now())
  reference         String?
  notes             String?
  createdAt         DateTime         @default(now())
  documents         Document[]
  bankAccount       BankAccount?     @relation(fields: [bankAccountId], references: [id])
  createdBy         FirmUser?        @relation(fields: [createdById], references: [id])
  firm              Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  supplier          Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([firmId, paymentNumber])
  @@unique([firmId, reference])
  @@index([firmId])
  @@index([supplierId])
  @@index([purchaseInvoiceId])
}

model TrustAccount {
  id              String                @id @default(cuid())
  firmId          String
  name            String
  bankName        String?
  accountNumber   String?
  branchCode      String?
  currency        String                @default("ZAR")
  active          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  firm            Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  reconciliations TrustReconciliation[]
  transactions    TrustTransaction[]

  @@index([firmId])
}

model TrustTransaction {
  id              String                 @id @default(cuid())
  firmId          String
  trustAccountId  String
  clientId        String?
  matterId        String?
  createdById     String?
  type            TrustTransactionType
  status          TrustTransactionStatus @default(POSTED)
  amount          Decimal                @db.Decimal(18, 2)
  transactionDate DateTime               @default(now())
  reference       String?
  description     String?
  createdAt       DateTime               @default(now())
  documents       Document[]
  client          Client?                @relation(fields: [clientId], references: [id])
  createdBy       FirmUser?              @relation(fields: [createdById], references: [id])
  firm            Firm                   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter          Matter?                @relation(fields: [matterId], references: [id])
  trustAccount    TrustAccount           @relation(fields: [trustAccountId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([trustAccountId])
  @@index([clientId])
  @@index([matterId])
}

model TrustReconciliation {
  id                 String               @id @default(cuid())
  firmId             String
  trustAccountId     String
  reconciliationDate DateTime             @default(now())
  statementBalance   Decimal              @db.Decimal(18, 2)
  ledgerBalance      Decimal              @db.Decimal(18, 2)
  difference         Decimal              @db.Decimal(18, 2)
  status             ReconciliationStatus @default(OPEN)
  notes              String?
  createdAt          DateTime             @default(now())
  firm               Firm                 @relation(fields: [firmId], references: [id], onDelete: Cascade)
  trustAccount       TrustAccount         @relation(fields: [trustAccountId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([trustAccountId])
}

model TaxReturn {
  id          String          @id @default(cuid())
  firmId      String
  taxType     String?
  periodStart DateTime
  periodEnd   DateTime
  status      TaxReturnStatus @default(DRAFT)
  preparedBy  String?
  submittedAt DateTime?
  reference   String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  inputVat    Decimal         @default(0) @db.Decimal(18, 2)
  netVat      Decimal         @default(0) @db.Decimal(18, 2)
  outputVat   Decimal         @default(0) @db.Decimal(18, 2)
  preparedAt  DateTime?
  returnType  String?
  documents   Document[]
  firm        Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([periodStart, periodEnd])
}

model Document {
  id                 String            @id @default(cuid())
  firmId             String
  originalName       String
  storageName        String
  storageKey         String
  storageProvider    String            @default("LOCAL")
  mimeType           String
  fileSizeBytes      Int
  checksum           String?
  documentType       DocumentType      @default(OTHER)
  status             DocumentStatus    @default(ACTIVE)
  description        String?
  uploadedById       String?
  financialPeriodId  String?
  clientId           String?
  matterId           String?
  invoiceId          String?
  paymentId          String?
  creditNoteId       String?
  expenseId          String?
  bankTransactionId  String?
  purchaseInvoiceId  String?
  supplierPaymentId  String?
  trustTransactionId String?
  taxReturnId        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  bankTransaction    BankTransaction?  @relation(fields: [bankTransactionId], references: [id])
  client             Client?           @relation(fields: [clientId], references: [id])
  creditNote         CreditNote?       @relation(fields: [creditNoteId], references: [id])
  expense            Expense?          @relation(fields: [expenseId], references: [id])
  financialPeriod    FinancialPeriod?  @relation(fields: [financialPeriodId], references: [id])
  firm               Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invoice            Invoice?          @relation(fields: [invoiceId], references: [id])
  matter             Matter?           @relation(fields: [matterId], references: [id])
  payment            Payment?          @relation(fields: [paymentId], references: [id])
  purchaseInvoice    PurchaseInvoice?  @relation(fields: [purchaseInvoiceId], references: [id])
  supplierPayment    SupplierPayment?  @relation(fields: [supplierPaymentId], references: [id])
  taxReturn          TaxReturn?        @relation(fields: [taxReturnId], references: [id])
  trustTransaction   TrustTransaction? @relation(fields: [trustTransactionId], references: [id])
  uploadedBy         FirmUser?         @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([firmId])
  @@index([uploadedById])
  @@index([financialPeriodId])
  @@index([clientId])
  @@index([matterId])
  @@index([invoiceId])
  @@index([paymentId])
  @@index([creditNoteId])
  @@index([expenseId])
  @@index([bankTransactionId])
  @@index([purchaseInvoiceId])
  @@index([supplierPaymentId])
  @@index([trustTransactionId])
  @@index([taxReturnId])
  @@index([documentType])
  @@index([status])
  @@index([createdAt])
}

enum Role {
  OWNER
  ADMIN
  FINANCE
  LAWYER
  STAFF
  ACCOUNTANT
}

enum ClientType {
  INDIVIDUAL
  COMPANY
  TRUST
  GOVERNMENT
  OTHER
}

enum MatterStatus {
  OPEN
  ON_HOLD
  CLOSED
  ARCHIVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  RECEIVED
  ALLOCATED
  PARTIALLY_ALLOCATED
  REFUNDED
  VOID
  COMPLETED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  REJECTED
}

enum BankTransactionType {
  DEBIT
  CREDIT
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum ReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  REVIEWED
  FLAGGED
  CORRECTED
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum SupplierType {
  COMPANY
  INDIVIDUAL
  PROFESSIONAL
  GOVERNMENT
  OTHER
}

enum PurchaseInvoiceStatus {
  DRAFT
  RECEIVED
  APPROVED
  PARTIALLY_PAID
  PAID
  VOID
}

enum TrustTransactionType {
  RECEIPT
  PAYMENT
  TRANSFER
  REFUND
  INTEREST
  ADJUSTMENT
